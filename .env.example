# Copy to .env (git-ignored) and fill in. The scripts in scripts/ read it so you
# don't have to pass these as flags. Flags and real environment variables win.

# Domain of the editor (served by this repo's GitHub Pages), e.g. edit.trips.example.com
EDITOR_DOMAIN=

# Domain of the trips site (served by the data repo's GitHub Pages), e.g. trips.example.com
SITE_DOMAIN=

# The private data repo as owner/name. Dots are allowed, e.g. you/trips.example.com
DATA_REPO=

# Optional: written to the data repo's config.json by create-data-repo.sh
MAPS_KEY=
MAP_ID=
AUTHOR=
